# TMDB — catálogo de filmes e séries (https://www.themoviedb.org/settings/api)
# Use o "API Read Access Token" (v4) como Bearer token. Grátis para uso não-comercial.
# Server-side only (nunca exposta ao navegador)
TMDB_API_KEY=

# Datadog RUM (públicas por natureza — client token é feito para o browser)
NEXT_PUBLIC_DATADOG_APPLICATION_ID=
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=
# Só precisa se sua org não for US1 (ex.: datadoghq.eu, us5.datadoghq.com)
NEXT_PUBLIC_DATADOG_SITE=datadoghq.com

# URL pública do site (usada no sitemap/OG)
NEXT_PUBLIC_SITE_URL=
